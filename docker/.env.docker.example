# Copy to .env only if you do not already have one. Never commit real keys.
MODEL_NAME=your-tool-calling-model
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=your-api-key

# Optional external tools
SEARCH_API_KEY=
GAODE_MAP_API=

MAX_AGENT_ITERATIONS=10
MAX_TOOL_CALLS=16
AGENT_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=15
HISTORY_MAX_TOKENS=4000
TOOL_CONCURRENCY_LIMITS='{"search_information":2,"weather_query_gaode":3,"route_planning":2,"query_train_tickets":1}'

# Compose enforces these two values even if .env differs.
APP_ENVIRONMENT=production
ENABLE_LOCAL_PYTHON_EXECUTION=false
PYTHON_MAX_OUTPUT_CHARS=20000
LOG_LEVEL=INFO
