#model相关
MODEL_NAME="qwen3.7-max"
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_API_KEY= ...

#工具相关
#谷歌搜索api
SEARCH_API_KEY= ...
#高德地图api
GAODE_MAP_API = ...
# Agent 运行预算
MAX_TOOL_CALLS=30
MAX_AGENT_ITERATIONS=15
AGENT_TIMEOUT_SECONDS=500
TOOL_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=500
HISTORY_MAX_TOKENS=30000
ENABLE_LOCAL_PYTHON_EXECUTION=false
PYTHON_MAX_OUTPUT_CHARS=20000
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
# 每个工具的最大同时执行数；未列出的内置工具保留默认值
TOOL_CONCURRENCY_LIMITS='{"search_information":2,"weather_query_gaode":3,"route_planning":2,"query_train_tickets":1,"get_current_time":8,"read_file_content":4,"list_directory":4,"write_new_file":1,"execute_local_python_unsafe":1}'
